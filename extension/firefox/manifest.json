{
  "manifest_version": 2,
  "name": "Local Bookmark Sync",
  "version": "0.1.0",
  "description": "Synchronizes bookmarks only through a local user-owned daemon.",
  "permissions": ["bookmarks", "storage", "nativeMessaging"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": { "default_popup": "popup.html" },
  "applications": { "gecko": { "id": "bookmark-sync@local" } }
}
